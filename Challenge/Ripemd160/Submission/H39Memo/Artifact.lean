def op (opcode : UInt8) : Instr :=
  match Decode.opcodeOf opcode with
  | some decoded => .op decoded
  | none => .op .INVALID

private theorem assemble_append (left right : List Instr) :
    assemble (left ++ right) = assemble left ++ assemble right := by
  apply ByteArray.ext
  simp [assemble, assembleBytes_append, List.append_toArray]

